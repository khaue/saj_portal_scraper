{
  "name": "SAJ Portal Scraper",
  "version": "2.0.0",
  "slug": "saj_portal_scraper",
  "description": "Fetches inverter data from SAJ API without a browser and publishes via MQTT.",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "init": false,
  "map": [
    "data:rw"
  ],
  "services": [
    "mqtt:need"
  ],
  "hassio_api": true,
  "host_network": true,
  "startup": "application",
  "boot": "auto"
}